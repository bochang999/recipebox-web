{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint/eslint-plugin"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx"],
      "env": {
        "browser": true,
        "es2021": true
      }
    },
    {
      "files": ["sw.js", "dist/sw.js", "www/sw.js"],
      "env": {
        "serviceworker": true,
        "es2021": true
      }
    },
    {
      "files": ["*.js"],
      "env": {
        "node": true,
        "es2021": true
      },
      "rules": {
        "@typescript-eslint/no-require-imports": "off",
        "no-undef": "off"
      }
    }
  ]
}